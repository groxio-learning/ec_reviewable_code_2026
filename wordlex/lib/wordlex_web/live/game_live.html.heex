<Layouts.app flash={@flash}>
  <section id="wordlex-game" class="mx-auto flex w-full max-w-xl flex-col items-center">
    <div class="w-full text-center">
      <p class="text-xs font-bold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-400">
        Six tries. One word.
      </p>
      <h1 class="mt-2 text-4xl font-black tracking-tight text-stone-950 dark:text-stone-50 sm:text-5xl">
        Wordlex
      </h1>
    </div>

    <section
      id="how-to-play"
      aria-labelledby="how-to-play-title"
      class="mt-5 w-full rounded-2xl border border-stone-200 bg-white/75 px-4 py-3 shadow-sm dark:border-stone-700 dark:bg-stone-900/70"
    >
      <h2 id="how-to-play-title" class="text-sm font-bold text-stone-900 dark:text-stone-100">
        How to play
      </h2>
      <p class="mt-1 text-sm leading-6 text-stone-600 dark:text-stone-300">
        Guess the five-letter word in six tries. Correct letters are in the right spot,
        present letters are in the wrong spot, and absent letters are not in the word.
      </p>
      <div class="mt-3 flex flex-wrap gap-2 text-xs font-bold" aria-label="Letter feedback legend">
        <span class="rounded-md bg-emerald-600 px-2 py-1 text-white">Correct</span>
        <span class="rounded-md bg-amber-500 px-2 py-1 text-stone-950">Present</span>
        <span class="rounded-md bg-stone-600 px-2 py-1 text-white">Absent</span>
      </div>
    </section>

    <div class="mt-5 flex w-full items-center justify-between gap-4 border-y border-stone-200 py-3 dark:border-stone-700">
      <p
        id="game-status"
        class="text-sm font-bold text-stone-800 dark:text-stone-100"
        aria-live="polite"
        data-status={@game_view.status}
      >
        {@game_view.status_message}
        <span
          :if={@game_view.answer}
          id="revealed-answer"
          class="text-emerald-700 dark:text-emerald-400"
        >
          {@game_view.answer}
        </span>
      </p>
      <p
        id="attempts-remaining"
        class="text-xs font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400"
      >
        {@game_view.attempts_remaining} tries left
      </p>
    </div>

    <div id="game-board" class="mt-5 grid gap-1.5" role="grid" aria-label="Wordlex guesses">
      <div
        :for={row <- @game_view.rows}
        id={"guess-row-#{row.index}"}
        class="grid grid-cols-5 gap-1.5"
        role="row"
      >
        <div
          :for={{tile, column} <- Enum.with_index(row.tiles, 1)}
          id={"tile-#{row.index}-#{column}"}
          class={[
            "flex size-12 items-center justify-center rounded-lg border-2 text-2xl font-black shadow-sm transition duration-200 sm:size-14",
            tile_classes(tile.state)
          ]}
          role="gridcell"
          aria-label={tile.label}
          data-state={tile.state}
        >
          <span aria-hidden="true">{tile.letter}</span>
        </div>
      </div>
    </div>

    <.form
      for={@form}
      id="guess-form"
      phx-submit="guess"
      class="mt-6 w-full rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-stone-700 dark:bg-stone-900"
    >
      <div class="flex items-start gap-3">
        <div class="min-w-0 flex-1">
          <.input
            field={@form[:word]}
            id="guess-word"
            type="text"
            label="Your five-letter guess"
            maxlength="5"
            minlength="5"
            pattern="[A-Za-z]{5}"
            autocomplete="off"
            required
            disabled={not @game_view.can_guess?}
            class="h-12 w-full rounded-xl border-2 border-stone-300 bg-stone-50 px-4 text-center text-lg font-black uppercase tracking-[0.3em] text-stone-950 outline-none transition placeholder:font-normal placeholder:tracking-normal focus:border-emerald-600 focus:ring-4 focus:ring-emerald-600/15 disabled:cursor-not-allowed disabled:opacity-50 dark:border-stone-600 dark:bg-stone-800 dark:text-white dark:focus:border-emerald-400"
            error_class="h-12 w-full rounded-xl border-2 border-rose-500 bg-rose-50 px-4 text-center text-lg font-black uppercase tracking-[0.3em] text-stone-950 outline-none ring-4 ring-rose-500/10 dark:bg-rose-950/30 dark:text-white"
          />
        </div>
        <button
          id="submit-guess"
          type="submit"
          disabled={not @game_view.can_guess?}
          class="mt-6 h-12 shrink-0 rounded-xl bg-stone-950 px-5 text-sm font-black text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-emerald-700 focus:outline-none focus:ring-4 focus:ring-emerald-600/25 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:translate-y-0 dark:bg-stone-100 dark:text-stone-950 dark:hover:bg-emerald-400"
        >
          Guess
        </button>
      </div>
    </.form>

    <section id="keyboard" aria-label="Letter keyboard" class="mt-5 w-full space-y-1.5">
      <div :for={key_row <- @game_view.keyboard} class="flex justify-center gap-1 sm:gap-1.5">
        <span
          :for={key <- key_row}
          id={"key-#{String.downcase(key.letter)}"}
          class={[
            "flex h-10 min-w-7 flex-1 items-center justify-center rounded-md border text-xs font-black transition-colors duration-200 sm:h-11 sm:min-w-9 sm:text-sm",
            key_classes(key.state)
          ]}
          aria-label={key.label}
          data-state={key.state}
        >
          {key.letter}
        </span>
      </div>
    </section>

    <button
      id="new-game"
      type="button"
      phx-click="new_game"
      class="mt-6 rounded-full border border-stone-300 bg-white px-5 py-2.5 text-sm font-bold text-stone-700 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-600 hover:text-emerald-700 focus:outline-none focus:ring-4 focus:ring-emerald-600/20 dark:border-stone-600 dark:bg-stone-900 dark:text-stone-200 dark:hover:border-emerald-400 dark:hover:text-emerald-400"
    >
      New game
    </button>
  </section>
</Layouts.app>
