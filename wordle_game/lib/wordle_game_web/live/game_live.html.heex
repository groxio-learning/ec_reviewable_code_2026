<div class="flex flex-col items-center justify-center min-h-screen bg-gray-100">
  <div class="bg-white rounded-lg shadow-lg p-8 max-w-md w-full">
    <h1 class="text-4xl font-bold text-center mb-8 text-gray-800">Wordle</h1>

    <!-- Game Board -->
    <div class="mb-8">
      <h2 class="text-lg font-semibold mb-4 text-gray-700">Guesses</h2>
      <div class="space-y-2">
        <%= if Enum.empty?(@game.guesses) do %>
          <p class="text-gray-500 text-center">No guesses yet</p>
        <% else %>
          <%= for {guess, idx} <- Enum.with_index(@game.guesses) do %>
            <div class="flex justify-between items-center p-2 bg-gray-50 rounded">
              <span class="font-mono text-lg"><%= guess %></span>
              <%= if idx == length(@game.guesses) - 1 and @last_feedback != [] do %>
                <div class="flex gap-1">
                  <%= for feedback <- @last_feedback do %>
                    <span class={
                      case feedback do
                        :correct -> "inline-block w-6 h-6 bg-green-500 text-white text-center text-xs rounded"
                        :wrong_position -> "inline-block w-6 h-6 bg-yellow-500 text-white text-center text-xs rounded"
                        :not_in_word -> "inline-block w-6 h-6 bg-gray-400 text-white text-center text-xs rounded"
                      end
                    }>•</span>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Game Status -->
    <div class="mb-6">
      <%= if @game.status == :won do %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded text-center">
          <strong>You Won!</strong> 🎉
        </div>
      <% end %>
      <%= if @game.status == :lost do %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded text-center">
          <strong>Game Over!</strong> The word was <strong><%= @game.secret %></strong>
        </div>
      <% end %>
      <%= if @game.status == :playing do %>
        <p class="text-gray-600 text-center">
          Guesses remaining: <strong><%= 6 - length(@game.guesses) %></strong>
        </p>
      <% end %>
    </div>

    <!-- Input Form -->
    <form id="guess-form" phx-submit="guess" class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-2">
        Guess (5 letters)
      </label>
      <input
        type="text"
        name="guess"
        maxlength="5"
        pattern="[A-Za-z]{5}"
        placeholder="HELLO"
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
        disabled={@game.status != :playing}
      />
      <button
        type="submit"
        class="w-full mt-2 bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded-lg disabled:bg-gray-400 disabled:cursor-not-allowed"
        disabled={@game.status != :playing}
      >
        Submit Guess
      </button>
    </form>

    <!-- New Game Button -->
    <button
      phx-click="new_game"
      class="w-full bg-gray-500 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded-lg"
    >
      New Game
    </button>

    <!-- Legend -->
    <div class="mt-8 text-xs text-gray-600">
      <p class="mb-2 font-semibold">Legend:</p>
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="inline-block w-4 h-4 bg-green-500 rounded"></span>
          <span>Correct position</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-block w-4 h-4 bg-yellow-500 rounded"></span>
          <span>Wrong position</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-block w-4 h-4 bg-gray-400 rounded"></span>
          <span>Not in word</span>
        </div>
      </div>
    </div>
  </div>
</div>
